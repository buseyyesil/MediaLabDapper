@model MediaLabDapper.DTOs.FeatureDto.CreateFeatureDto
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h3 class="page-title">Yeni Feature Ekle</h3>
</div>
<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <form asp-action="CreateFeature" method="post">
                    <div class="form-group">
                        <label>Başlık</label>
                        <input asp-for="Title" class="form-control" placeholder="Başlık giriniz" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Açıklama giriniz"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>İkon</label>
                        <input asp-for="Icon" class="form-control" placeholder="Örn: bi bi-clipboard-data" />
                        <span asp-validation-for="Icon" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Kaydet</button>
                    <a asp-action="Index" class="btn btn-light">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>