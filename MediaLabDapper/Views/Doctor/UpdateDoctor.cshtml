@model MediaLabDapper.DTOs.DoctorDtos.UpdateDoctorDto
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h3 class="page-title">Doktor Güncelle</h3>
</div>
<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <form asp-action="UpdateDoctor" method="post">
                    <input type="hidden" asp-for="DoctorId" />
                    <div class="form-group">
                        <label>Ad Soyad</label>
                        <input asp-for="NameSurname" class="form-control" />
                        <span asp-validation-for="NameSurname" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>Resim URL</label>
                        <input asp-for="ImageUrl" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Bölüm</label>
                        <select asp-for="DepartmentId" asp-items="@ViewBag.departments" class="form-control">
                            <option disabled>Bölüm Seçiniz</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Güncelle</button>
                    <a asp-action="Index" class="btn btn-light">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>