@model IEnumerable<MediaLabDapper.DTOs.DoctorDtos.ResultDoctorWithDepartmentDto>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="page-header">
    <h3 class="page-title">Doktor Listesi</h3>
</div>
<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <a asp-action="CreateDoctor" class="btn btn-primary mb-3">Yeni Ekle</a>
                <div class="table-responsive">
                    <table class="table">
                        <thead class="bg-light">
                            <tr>
                                <th>#</th>
                                <th>Resim</th>
                                <th>Ad Soyad</th>
                                <th>Açıklama</th>
                                <th>Bölüm</th>
                                <th>Müsaitlik</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.DoctorId</td>
                                    <td><img src="@item.ImageUrl" style="height:50px;width:50px;border-radius:50%" /></td>
                                    <td>@item.NameSurname</td>
                                    <td>@item.Description</td>
                                    <td>@item.DepartmentName</td>
                                    <td>
                                        @if (item.IsAvailable)
                                        {
                                            <a asp-action="ToggleAvailability" asp-route-id="@item.DoctorId" class="badge badge-success" style="cursor:pointer; font-size:13px; padding:6px 12px;">
                                                ✅ Müsait
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="ToggleAvailability" asp-route-id="@item.DoctorId" class="badge badge-danger" style="cursor:pointer; font-size:13px; padding:6px 12px;">
                                                ❌ Müsait Değil
                                            </a>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="UpdateDoctor" asp-route-id="@item.DoctorId" class="btn btn-warning btn-sm">Güncelle</a>
                                        <a asp-action="DeleteDoctor" asp-route-id="@item.DoctorId" class="btn btn-danger btn-sm">Sil</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>