@model IEnumerable<MediaLabDapper.DTOs.TestimonialDto.ResultTestimonialDto>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h3 class="page-title">Yorum Listesi</h3>
</div>
<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <a asp-action="CreateTestimonial" class="btn btn-primary mb-3">Yeni Ekle</a>
                <div class="table-responsive">
                    <table class="table">
                        <thead class="bg-light">
                            <tr>
                                <th>#</th>
                                <th>Ad Soyad</th>
                                <th>Başlık</th>
                                <th>Yorum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.TestimonialId</td>
                                    <td>@item.FullName</td>
                                    <td>@item.Title</td>
                                    <td>@item.Comment</td>
                                    <td>
                                        <a asp-action="UpdateTestimonial" asp-route-id="@item.TestimonialId" class="btn btn-warning btn-sm">Güncelle</a>
                                        <a asp-action="DeleteTestimonial" asp-route-id="@item.TestimonialId" class="btn btn-danger btn-sm">Sil</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>