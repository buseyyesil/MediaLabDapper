@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>⚕️Medilab⚕️</title>
    <link href="~/MediLab-1.0.0/assets/img/favicon.png" rel="icon">
    <link href="https://fonts.googleapis.com/css2?family=Roboto&family=Poppins&family=Raleway&display=swap" rel="stylesheet">
    <link href="~/MediLab-1.0.0/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/MediLab-1.0.0/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/MediLab-1.0.0/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/MediLab-1.0.0/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="~/MediLab-1.0.0/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/MediLab-1.0.0/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <link href="~/MediLab-1.0.0/assets/css/main.css" rel="stylesheet">
</head>
<body class="index-page">
    @await Component.InvokeAsync("HeaderViewComponent")

    <main class="main">
        @await Component.InvokeAsync("FeatureViewComponent")
        @await Component.InvokeAsync("AboutViewComponent")
        @await Component.InvokeAsync("StatsViewComponent")
        @await Component.InvokeAsync("ServicesViewComponent")
        @await Component.InvokeAsync("AppointmentViewComponent")
        @await Component.InvokeAsync("DepartmentsViewComponent")
        @await Component.InvokeAsync("DoctorViewComponent")
        @await Component.InvokeAsync("TestimonialsViewComponent")
        @await Component.InvokeAsync("ContactViewComponent")
    </main>

    @await Component.InvokeAsync("FooterViewComponent")
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <script src="~/MediLab-1.0.0/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/MediLab-1.0.0/assets/vendor/aos/aos.js"></script>
    <script src="~/MediLab-1.0.0/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/MediLab-1.0.0/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/MediLab-1.0.0/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/MediLab-1.0.0/assets/js/main.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["Success"] != null)
    {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            window.onload = function () {
                Swal.fire({
                    icon: 'success',
                    title: 'Başarılı!',
                    text: 'Randevunuz başarıyla oluşturuldu!',
                    confirmButtonText: 'Tamam',
                    confirmButtonColor: '#0d6efd'
                });
            }
        </script>
    }
</body>
</html>