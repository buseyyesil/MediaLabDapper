<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Yönetim Paneli</title>
    <link rel="stylesheet" href="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/template/assets/vendors/mdi/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/template/assets/vendors/css/vendor.bundle.base.css" />
    <link rel="stylesheet" href="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/template/assets/css/style.css" />
    <link rel="shortcut icon" href="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/template/assets/images/favicon.png" />
    <style>
        body, .container-scroller {
            min-height: 100vh;
        }

        .sidebar {
            min-height: 100vh;
        }
    </style>
</head>
<body>
    <div class="container-scroller">

        <nav class="sidebar sidebar-offcanvas" id="sidebar">
            <div class="text-center sidebar-brand-wrapper d-flex align-items-center">
                <a class="sidebar-brand brand-logo" href="/">
                    <img src="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/template/assets/images/logo.svg" alt="logo" />
                </a>
                <a class="sidebar-brand brand-logo-mini pl-4 pt-3" href="/">
                    <img src="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/template/assets/images/logo-mini.svg" alt="logo" />
                </a>
            </div>
            <ul class="nav">
                <li class="nav-item nav-profile">
                    <a href="#" class="nav-link">
                        <div class="nav-profile-image">
                            <img src="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/kisi.jpg" alt="profile" />
                            <span class="login-status online"></span>
                        </div>
                        <div class="nav-profile-text d-flex flex-column pr-3">
                            <span class="font-weight-medium mb-2">Admin</span>
                            <span class="font-weight-normal">MediLab Yönetici</span>
                        </div>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                        <i class="mdi mdi-home menu-icon"></i>
                        <span class="menu-title">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Feature" asp-action="Index">
                        <i class="mdi mdi-star menu-icon"></i>
                        <span class="menu-title">Öne Çıkan Alan</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="About" asp-action="Index">
                        <i class="mdi mdi-information menu-icon"></i>
                        <span class="menu-title">Hakkımızda</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Service" asp-action="Index">
                        <i class="mdi mdi-briefcase menu-icon"></i>
                        <span class="menu-title">Hizmetler</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Department" asp-action="Index">
                        <i class="mdi mdi-hospital menu-icon"></i>
                        <span class="menu-title">Bölümler</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Doctor" asp-action="Index">
                        <i class="mdi mdi-doctor menu-icon"></i>
                        <span class="menu-title">Doktorlar</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Appointment" asp-action="Index">
                        <i class="mdi mdi-calendar menu-icon"></i>
                        <span class="menu-title">Randevular</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Testimonial" asp-action="Index">
                        <i class="mdi mdi-comment menu-icon"></i>
                        <span class="menu-title">Hasta Yorumları</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Contact" asp-action="Index">
                        <i class="mdi mdi-phone menu-icon"></i>
                        <span class="menu-title">İletişim</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="container-fluid page-body-wrapper">

            <div id="theme-settings" class="settings-panel">
                <i class="settings-close mdi mdi-close"></i>
                <p class="settings-heading">SIDEBAR SKINS</p>
                <div class="sidebar-bg-options selected" id="sidebar-default-theme">
                    <div class="img-ss rounded-circle bg-light border mr-3"></div> Default
                </div>
                <div class="sidebar-bg-options" id="sidebar-dark-theme">
                    <div class="img-ss rounded-circle bg-dark border mr-3"></div> Dark
                </div>
                <p class="settings-heading mt-2">HEADER SKINS</p>
                <div class="color-tiles mx-0 px-4">
                    <div class="tiles light"></div>
                    <div class="tiles dark"></div>
                </div>
            </div>

            <nav class="navbar col-lg-12 col-12 p-lg-0 fixed-top d-flex flex-row">
                <div class="navbar-menu-wrapper d-flex align-items-stretch justify-content-between">
                    <a class="navbar-brand brand-logo-mini align-self-center d-lg-none" href="/">
                        <img src="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/template/assets/images/logo-mini.svg" alt="logo" />
                    </a>
                    <button class="navbar-toggler navbar-toggler align-self-center mr-2" type="button" data-toggle="minimize">
                        <i class="mdi mdi-menu"></i>
                    </button>
                    <ul class="navbar-nav navbar-nav-right ml-lg-auto">
                        <li class="nav-item nav-profile dropdown border-0">
                            <a class="nav-link dropdown-toggle" id="profileDropdown" href="#" data-toggle="dropdown">
                                <img class="nav-profile-img mr-2" alt="" src="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/kisi.jpg" />
                                <span class="profile-name">Admin</span>
                            </a>
                            <div class="dropdown-menu navbar-dropdown w-100" aria-labelledby="profileDropdown">
                                <a class="dropdown-item" href="/">
                                    <i class="mdi mdi-home mr-2 text-success"></i> Siteye Git
                                </a>
                            </div>
                        </li>
                    </ul>
                    <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                        <span class="mdi mdi-menu"></span>
                    </button>
                </div>
            </nav>

            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted d-block text-center text-sm-left d-sm-inline-block">
                            MediLab Hastanesi Yönetim Paneli
                        </span>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <script src="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/template/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/template/assets/js/off-canvas.js"></script>
    <script src="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/template/assets/js/hoverable-collapse.js"></script>
    <script src="~/Breeze-Free-Bootstrap-Admin-Template-1.0.0/template/assets/js/misc.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>