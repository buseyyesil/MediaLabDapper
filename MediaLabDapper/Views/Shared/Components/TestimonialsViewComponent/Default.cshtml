@model IEnumerable<MediaLabDapper.DTOs.TestimonialDto.ResultTestimonialDto>

<section id="testimonials" class="testimonials section">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-5 info" data-aos="fade-up" data-aos-delay="100">
                <h3>Hasta Yorumları</h3>
                <p>Hastalarımızın deneyimleri ve memnuniyetleri bizim için en büyük referanstır.</p>
            </div>

            <div class="col-lg-7" data-aos="fade-up" data-aos-delay="200">
                <div class="swiper init-swiper">

                    <script type="application/json" class="swiper-config">
                        {
                          "loop": true,
                          "speed": 600,
                          "autoplay": { "delay": 5000 },
                          "slidesPerView": "auto",
                          "pagination": {
                            "el": ".swiper-pagination",
                            "type": "bullets",
                            "clickable": true
                          }
                        }
                    </script>

                    <div class="swiper-wrapper">

                        @foreach (var item in Model)
                        {
                            <div class="swiper-slide">
                                <div class="testimonial-item">
                                    <div class="d-flex">

                                        <img src="@item.ImageUrl" class="testimonial-img flex-shrink-0" alt="">

                                        <div>
                                            <h3>@item.FullName</h3>
                                            <h4>@item.Title</h4>

                                            <div class="stars">
                                                <i class="bi bi-star-fill"></i>
                                                <i class="bi bi-star-fill"></i>
                                                <i class="bi bi-star-fill"></i>
                                                <i class="bi bi-star-fill"></i>
                                                <i class="bi bi-star-fill"></i>
                                            </div>
                                        </div>

                                    </div>

                                    <p>
                                        <i class="bi bi-quote quote-icon-left"></i>
                                        <span>@item.Comment</span>
                                        <i class="bi bi-quote quote-icon-right"></i>
                                    </p>

                                </div>
                            </div>
                        }

                    </div>

                    <div class="swiper-pagination"></div>

                </div>
            </div>

        </div>
    </div>
</section>