@model IEnumerable<MediaLabDapper.DTOs.ServiceDto.ResultServiceDto>

<section id="services" class="services section">

    <div class="container section-title" data-aos="fade-up">
        <h2>Hizmetlerimiz</h2>
        <p>Modern teknoloji ve uzman kadromuz ile kaliteli sağlık hizmeti sunuyoruz.</p>
    </div>

    <div class="container">
        <div class="row gy-4">

            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6" data-aos="fade-up">
                    <div class="service-item position-relative">

                        <div class="icon">
                            <i class="@item.Icon"></i>
                        </div>

                        <a href="#" class="stretched-link">
                            <h3>@item.Title</h3>
                        </a>

                        <p>@item.Description</p>

                    </div>
                </div>
            }

        </div>
    </div>

</section>