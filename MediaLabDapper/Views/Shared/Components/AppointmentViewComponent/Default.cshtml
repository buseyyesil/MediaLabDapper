@model MediaLabDapper.DTOs.AppointmentDtos.CreateAppointmentDto

<section id="appointment" class="appointment section">
    <div class="container section-title" data-aos="fade-up">
        <h2>Randevu Oluştur</h2>
        <p>Sağlığınız için hızlı ve kolay bir şekilde randevu oluşturabilirsiniz.</p>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <form asp-controller="Appointment" asp-action="CreateAppointment" method="post" class="php-email-form">

            <div class="row">
                <div class="col-md-4 form-group">
                    <input asp-for="FullName" class="form-control" placeholder="Ad Soyad" required="">
                </div>

                <div class="col-md-4 form-group mt-3 mt-md-0">
                    <input asp-for="Email" class="form-control" placeholder="E-posta Adresi">
                </div>

                <div class="col-md-4 form-group mt-3 mt-md-0">
                    <input asp-for="Phone" class="form-control" placeholder="Telefon Numarası" required="">
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 form-group mt-3">
                    <input asp-for="Date" type="date" class="form-control" required="">
                </div>

                <div class="col-md-4 form-group mt-3">
                    <input asp-for="Time" type="time" class="form-control" required="">
                </div>

                <div class="col-md-4 form-group mt-3">
                    <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
                        <option value="">Bölüm Seçiniz</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 form-group mt-3">
                    <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select">
                        <option value="">Doktor Seçiniz</option>
                    </select>
                </div>
            </div>

            <div class="form-group mt-3">
                <textarea asp-for="Message" class="form-control" rows="5" placeholder="Mesajınız (Opsiyonel)"></textarea>
            </div>

            <div class="mt-3">
                <div class="text-center">
                    <button type="submit">Randevu Oluştur</button>
                </div>
            </div>

        </form>

    </div>
</section>