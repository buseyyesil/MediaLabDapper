@model IEnumerable<MediaLabDapper.DTOs.ServiceDto.ResultServiceDto>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h3 class="page-title">Servis Listesi</h3>
</div>
<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <a asp-action="CreateService" class="btn btn-primary mb-3">Yeni Ekle</a>
                <div class="table-responsive">
                    <table class="table">
                        <thead class="bg-light">
                            <tr>
                                <th>#</th>
                                <th>Başlık</th>
                                <th>Açıklama</th>
                                <th>İkon</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ServicesId</td>
                                    <td>@item.Title</td>
                                    <td>@item.Description</td>
                                    <td><i class="@item.Icon"></i></td>
                                    <td>
                                        <a asp-action="UpdateService" asp-route-id="@item.ServicesId" class="btn btn-warning btn-sm">Güncelle</a>
                                        <a asp-action="DeleteService" asp-route-id="@item.ServicesId" class="btn btn-danger btn-sm">Sil</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>