@model IEnumerable<MediaLabDapper.DTOs.AppointmentDtos.ResultAppointmentDto>
@using MediaLabDapper.DTOs.AppointmentDtos
@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<div class="page-header">
    <h3 class="page-title">Randevularım</h3>
</div>

<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <thead class="bg-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Saat</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Time</td>
                                    <td>
                                        @{
                                            var (badgeClass, badgeText) = item.IsApproved switch
                                            {
                                                AppointmentStatusDto.Beklemede => ("badge-warning", "Bekleyen"),
                                                AppointmentStatusDto.Onaylı => ("badge-success", "Onaylı"),
                                                AppointmentStatusDto.Reddedildi => ("badge-danger", "Reddedildi"),
                                                _ => ("badge-secondary", "Bilinmiyor")
                                            };
                                        }
                                        <span class="badge @badgeClass">@badgeText</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>