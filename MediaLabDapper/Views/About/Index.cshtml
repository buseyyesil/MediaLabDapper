@model IEnumerable<MediaLabDapper.DTOs.AboutDtos.ResultAboutDto>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h3 class="page-title">About Listesi</h3>
</div>
<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <a asp-action="CreateAbout" class="btn btn-primary mb-3">Yeni Ekle</a>
                <div class="table-responsive">
                    <table class="table">
                        <thead class="bg-light">
                            <tr>
                                <th>#</th>
                                <th>Açıklama</th>
                                <th>Başlık 1</th>
                                <th>Başlık 2</th>
                                <th>Başlık 3</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.AboutId</td>
                                    <td>@item.Description?.Substring(0, Math.Min(50, item.Description.Length))...</td>
                                    <td>@item.Title1</td>
                                    <td>@item.Title2</td>
                                    <td>@item.Title3</td>
                                    <td>
                                        <a asp-action="UpdateAbout" asp-route-id="@item.AboutId" class="btn btn-warning btn-sm">Güncelle</a>
                                        <a asp-action="DeleteAbout" asp-route-id="@item.AboutId" class="btn btn-danger btn-sm">Sil</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>